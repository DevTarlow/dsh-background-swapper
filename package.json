{
  "name": "dsh-background-swapper",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin: set a photo as the harness background, name and paginate a library of them, and tint, blur or fade the interface on top.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevTarlow/dsh-background-swapper.git"
  },
  "homepage": "https://github.com/DevTarlow/dsh-background-swapper#readme",
  "bugs": {
    "url": "https://github.com/DevTarlow/dsh-background-swapper/issues"
  },
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "files": [
    "index.js",
    "store.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "background",
    "wallpaper",
    "theme"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
